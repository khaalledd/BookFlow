# ===============================
# Docker Compose Example Settings
# ===============================

# Runtime mode
NODE_ENV=development

# Database container credentials
POSTGRES_DB=bookflow
POSTGRES_USER=bookflow
POSTGRES_PASSWORD=bookflow

# Connection strings used by backend (container network)
DOCKER_DATABASE_URL=postgresql://bookflow:bookflow@postgres:5432/bookflow?schema=public
DOCKER_REDIS_URL=redis://redis:6379

# Backend port
PORT=3000

# JWT
JWT_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cloudinary (optional locally; required for upload endpoints)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_API_KEY=
CLOUDINARY_CLOUD_API_SECRET=

# Frontend -> backend URL
NEXT_PUBLIC_API_URL=http://localhost:3000
